FARM_DOMAIN=farm.example.com
CONSOLE_DOMAIN=console.farm.example.com
COOLIFY_NETWORK=coolify
FARM_SECRETS_DIR=/etc/android-farm/secrets
# Copy the exact value printed by `installer/install.py plan/apply`.
FARM_RELEASE_ID=REPLACE_WITH_16_HEX_RELEASE_ID
GRAFANA_DOMAIN=metrics.farm.example.com
GRAFANA_ADMIN_USER=admin
# The smart installer creates this root-owned 0600 secret; do not paste the password into Coolify.
GRAFANA_PASSWORD_FILE=/etc/android-farm/monitoring/grafana-admin-password
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=20GB
# REDROID_IMAGE applies to the base catalog. A QA profile selects its version in
# ops/device_profiles.py; pin that reviewed image there before a production pilot.
REDROID_IMAGE=redroid/redroid:12.0.0-latest
# These local build tags must remain writable tags, not @sha256 references.
PROXY_IMAGE=android-farm/proxy:1
SCREEN_IMAGE=android-farm/screen:1
